# ============================================================================
#  KONFIGURASI LENGKAP — vision RAG agent
#
#  >>>  CUKUP ISI SATU BARIS:  LLM_API_KEY  <<<
#  Semua nilai lain sudah terisi benar untuk server kamu.
#  Salin file ini menjadi `.env` (atau langsung edit `.env` yang sudah dibuat).
# ============================================================================

# ----------------------------------------------------------------------------
# GLOBAL — base URL + API key (fallback untuk VLM & OCR)
#
#   ISI SATU BARIS DI BAWAH INI:
#       LLM_API_KEY=sk-xxxxxx
#   (tulis key polos, TANPA kutip dan TANPA komentar di baris yang sama)
# ----------------------------------------------------------------------------
LLM_BASE_URL=http://10.7.1.21/v1
LLM_API_KEY=

# ----------------------------------------------------------------------------
# 1. VLM NORMAL  ->  qwen-35b-vision  (ekstraksi + agent)
#    Endpoint sama dengan global (port 80), otomatis kirim
#    chat_template_kwargs.enable_thinking=false agar tidak buang token.
# ----------------------------------------------------------------------------
VLM_MODEL=qwen-35b-vision
VLM_ENABLE_THINKING=false
VLM_TEMPERATURE=0.1
VLM_TIMEOUT=300

# ----------------------------------------------------------------------------
# 2. OCR  ->  ocr-lighton  (OCR terstruktur)
#    PENTING: OCR di PORT 4000, beda dari VLM (port 80), jadi OCR_BASE_URL
#    diisi eksplisit. Tanpa thinking (tidak dikirim), max_tokens 500.
# ----------------------------------------------------------------------------
OCR_BASE_URL=http://10.7.1.21:4000/v1
OCR_MODEL=ocr-lighton
OCR_TEMPERATURE=0.0
OCR_TIMEOUT=300
OCR_MAX_TOKENS=500

# ----------------------------------------------------------------------------
# 3. EMBEDDING  ->  multimodal teks+gambar (retrieval) — opsional
#    subprocess = binary llama-vl-embedding lokal (FULL teks+gambar)
#    http       = llama-server /v1/embeddings (hanya teks, tes remote)
#    Kalau belum pakai retrieval, abaikan bagian ini (default aman).
# ----------------------------------------------------------------------------
EMBEDDING_MODE=subprocess
EMBEDDING_MODEL=Qwen3-VL-Embedding-2B-f16.gguf
EMBEDDING_MMPROJ=mmproj-Qwen3-VL-Embedding-2B-f16.gguf

# Hanya untuk mode http:
EMBEDDING_BASE_URL=http://localhost:8080/v1
EMBEDDING_API_KEY=

# Hanya untuk mode subprocess (kosong = cari di PATH):
LLAMA_VL_EMBEDDING_BIN=

# Parameter embedding (opsional):
EMBEDDING_POOLING=last
EMBEDDING_NORMALIZE=2
EMBEDDING_CONTEXT=4096
EMBEDDING_NGL=auto
